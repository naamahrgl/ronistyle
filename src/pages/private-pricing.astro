---
// src/pages/private-pricing.astro
// NOT linked in navigation - share this URL directly with potential clients
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import logoImg from '~/assets/images/logobg.webp';
import bowtieImg from '~/assets/images/bowtie2.png';

const metadata = {
  title: 'התהליך והמחירון | Roni Style',
};
---

<Layout metadata={metadata}>
  <section class="bg-page py-10 md:py-16 px-4">

    <!-- INTRO -->
    <div class="max-w-3xl mx-auto text-center mb-10 md:mb-16">
  <div class="mb-5 flex justify-center">
  <Image src={logoImg} alt="Roni Style" width={180} class="h-auto" />
</div>
      <h1 class="text-2xl md:text-2xl font-bold text-primary mb-4">איך זה עובד?</h1>
      <p class="text-muted text-base md:text-lg">
        כאן תמצאו הסבר על התהליך, סוגי המפגשים והמחירון — כדי שתדעו בדיוק למה לצפות.
      </p>
    </div>

    <!-- PROCESS: two main sessions -->
    <div class="max-w-5xl mx-auto flex flex-col md:grid md:grid-cols-2 gap-4 md:gap-6 mb-4 md:mb-8 items-stretch">

      <div class="flex flex-col h-full rounded-xl border border-accent bg-thirdly shadow px-5 py-6 md:px-6 md:py-8">
        <div class="flex items-center gap-4 mb-5">
          <div class="rounded-full bg-primary p-2.5 shrink-0">
            <Icon name="tabler:home" class="w-5 h-5 text-accent" />
          </div>
          <div>
            <h2 class="text-lg md:text-xl font-semibold text-primary leading-tight">באה לביקור</h2>
            <p class="text-xs text-muted mt-1">אצלך בבית · עד 4 שעות · לקוחות חדשים וחוזרים</p>
          </div>
        </div>

  <div class="text-sm text-primary font-medium">
  <p style="line-height: 1.25rem; margin-bottom: 1rem;">
    היעד שלנו היא ליצור ארון בגדים אפקטיבי, שיהפוך את תהליך ההתארגנות שלך לפשוט ומהיר. כשתפתחו את
    הארון בבוקר, הבגדים המתאימים יהיו זמינים ומסודרים עבורך, ויהיה לך קל יותר לבחור את מה שנחוץ לכל
    מטרה - עבודה, פגישות, נסיעות, בילויים וכו׳.
  </p>
  <p style="line-height: 1.25rem; margin-bottom: 1rem;">
    השלב הראשון הוא מיון יסודי של המלתחה הקיימת: נבדוק יחד אילו גזרות, צבעים ובגדים מתאימים ומחמיאים לך,
    ונגדיר ביחד לך מה שכבר לא נוח או לא תואם לסגנון שלך. לאחר מכן ניצור יחד מגוון לוקים מתוך מה שכבר יש לך,
    ונעשה שילובים חדשים ומעניינים, כדי שתוכלי להפיק את המקסימום מכל בגד שקיים לך בארון.
  </p>
  <p style="line-height: 1.25rem; margin-bottom: 1rem;">
    במהלך התהליך, אני כמובן מצלמת אותך עם הלוקים שנבנה כדי שתוכלו לחזור אליהם במידת הצורך.
  </p>
  <p style="line-height: 1.25rem;">
    לבסוף, נבנה רשימה של פריטים שאולי חסרים במלתחה ויכולים להעשיר אותה בעתיד ובמידה ותרצו נעשה לנו את
    המפגש השני שהוא "יום הקניות הגדול" (ממליצה בחום).
  </p>
</div>
      </div>

      <div class="flex flex-col h-full rounded-xl border border-accent bg-thirdly shadow px-5 py-6 md:px-6 md:py-8">
        <div class="flex items-center gap-4 ">
          <div class="rounded-full bg-primary p-2.5 shrink-0">
            <Icon name="tabler:shopping-bag" class="w-5 h-5 text-accent" />
          </div>
          <div>
            <h2 class="text-lg md:text-xl font-semibold text-primary leading-tight">יום הקניות הגדול</h2>
            <p class="text-xs text-muted mt-1">המתקיים בת"א · עד 6 שעות · לקוחות חוזרים בלבד</p>
          </div>
        </div>

  <div class="text-sm text-primary font-medium">
  <p style="line-height: 1.25rem; margin-bottom: 1rem; margin-top: 1rem;">
            יום שכולו FUN! אני מגיעה לפניך למקום שנבחר יחד, ומכינה עבורך מלתחה התחלתית שתתאים לך.
          </p>
  <p style="line-height: 1.25rem; margin-bottom: 1rem;">
            כשתצטרפו, נתחיל במדידות, ונבדוק יחד מה מתאים לך ומה פחות, למה את מתחברים יותר ולמה פחות, ומשם
            נתגלגל ונדייק לך מלתחה עם פריטים שעושים לך הכי טוב ושתרגישו בהם הכי וואו.
          </p>
          <p style="line-height: 1.25rem; margin-bottom: 1rem;">
            בדרך כלל אני עורכת את היום הזה בקניון TLV - יש שם מגוון של הכל מהכל, גם פריטי יוקרה וגם בסיסיים.
          </p>
          <p style="line-height: 1.25rem; margin-bottom: 1rem;">
            אבל אם תרצו משהו אחר, אפשר ללכת לחנויות ייחודיות שנדוק לפי הכל התקציב וההסגנון שלך כמובן.
          </p>
          <p style="line-height: 1.25rem; margin-bottom: 1rem;">
            עם הרשימה שהכנו מראש, נבחר לך בגדים שיחמיאו ויתאימו למבנה הגוף שלך, נבחר צבעים ובגדים שעובדים טוב
            עבורך, והכי חשוב נעשה מזה יום שהוא FUN.
          </p>
          <p style="line-height: 1.25rem; margin-bottom: 1rem;">
            במהלך היום, אשתף אותך בטיפים איך לבחור את הפריטים המדויקים לך ואיך ליצור מגוון הופעות שלא היית
            חושבת עליהם.
          </p>
          <p style="line-height: 1.25rem; margin-bottom: 1rem;">
            נצא עם מלתחה חכמה, ממוקדת, ובסוף המסע הזה גם תדעו איך לגשת לרכישות לבדך בצורה חכמה ומדויקת יותר.
          </p>
  <p style="line-height: 1.25rem;">
            במהלך היום הזה אני כמובן מצלמת עבורך את הלוקים כדי שתוכלו לחזור "להעתיק" במידת הצורך.
          </p>
        </div>
      </div>
    </div>

    <!-- ADDITIONAL OPTIONS -->
    <div class="max-w-5xl mx-auto flex flex-col md:grid md:grid-cols-2 gap-4 md:gap-6 mb-10 md:mb-16 items-stretch">

      <div class="flex flex-col h-full rounded-xl border border-accent bg-thirdly shadow px-5 py-6 md:px-6 md:py-8">
        <div class="flex items-center gap-4 mb-5">
          <div class="rounded-full bg-primary p-2.5 shrink-0">
            <Icon name="tabler:refresh" class="w-5 h-5 text-accent" />
          </div>
          <div>
            <h3 class="text-base md:text-lg font-semibold text-primary leading-tight">באה לביקור קטן</h3>
            <p class="text-xs text-muted mt-1">עד שעתיים · לקוחות חוזרים בלבד</p>
          </div>
        </div>
  <div class="text-sm text-primary font-medium">
  <p style="line-height: 1.25rem; ">
            מיועד ללקוחות שרוצים לחדש מלתחה עם ביקור ביתי קצר עבור חידוש ורענון לקראת
            סיבוב קניות מחודש.
          </p>
        </div>
      </div>

      <div class="flex flex-col h-full rounded-xl border border-accent bg-thirdly shadow px-5 py-6 md:px-6 md:py-8">
        <div class="flex items-center gap-4 mb-5">
          <div class="rounded-full bg-primary p-2.5 shrink-0 mb-4">
            <Icon name="tabler:calendar-star" class="w-5 h-5 text-accent " />
          </div>
          <div>
            <h3 class="text-base md:text-lg font-semibold text-primary leading-tight">ארוע ממוקד</h3>
            <p class="text-xs text-muted mt-1">מתקיים בת"א · שעתיים · לקוחות חדשים וחוזרים</p>
          </div>
        </div>
      <div class="text-sm text-primary font-medium">
  <p style="line-height: 1.25rem; margin-bottom: 1rem;">
            מעניק ליווי אישי למציאת הלוק המושלם עבור אירוע ספציפי.
          </p>
  <p style="line-height: 1.25rem; margin-bottom: 1rem;">
            את יום הקניות נפתח בפגישת היכרות קצרה בבית קפה, שבה נכיר אחת את השנייה, נבין את הצרכים שלך ונדייק
            את הסגנון והלוק המתאימים לך במיוחד עבור האירוע.
          </p>
  <p style="line-height: 1.25rem; ">
            ומשם נמשיך יחד לקניות ממוקדות, מדויקת ויעילה.
          </p>
        </div>
      </div>
    </div>

    <!-- PRICING -->
 <!-- PRICING -->
    <div class="max-w-5xl mx-auto text-center mb-6 md:mb-8">
      <h2 class="text-xl md:text-2xl font-bold text-primary mb-2">כמה זה עולה?</h2>
      <p class="text-muted text-sm">כל המחירים כוללים ליווי אישי מלא לאורך המפגש</p>
    </div>

    <div class="max-w-6xl mx-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4 mb-10 md:mb-12 items-stretch">

      <!-- 1. Combo package - highlighted -->
      <div class="flex flex-col">
        <div class="relative flex flex-col w-full h-full rounded-xl border-2 border-primary bg-thirdly shadow-lg px-3 py-4 md:px-4 md:py-5">
          <div class="absolute -top-3 -right-3 z-[1] w-16 h-16 overflow-visible">
            <img src={bowtieImg.src} alt="Bowtie" class="w-full h-full object-contain rotate-45" />
          </div>
          <div class="flex-grow flex flex-col justify-between">
            <div>
              <div class="rounded-full bg-primary p-2.5 mx-auto mb-2 w-fit">
                <Icon name="tabler:sparkles" class="w-5 h-5 text-accent" />
              </div>
              <h3 class="text-sm md:text-base font-semibold uppercase text-primary text-center leading-tight">חבילת הפפיון</h3>
              <p class="font-light text-muted text-center mt-1 mb-2 text-xs leading-snug">באה לביקור + יום הקניות הגדול</p>
              <p class="text-center text-primary mb-1">
                <span class="text-2xl md:text-3xl font-bold">2,500</span>
                <span class="text-xs md:text-sm font-medium align-bottom">₪</span>
              </p>
              <p class="text-[11px] text-muted text-center mb-3">המחיר עשוי להשתנות בהתאם למרחק הנסיעה</p>
            </div>
          </div>
          <div class="flex justify-center">
            <Button text="לתיאום פגישה" href="https://wa.me/972543452440" class="w-full text-sm" />
          </div>
        </div>
      </div>

      <!-- 2. Shopping day only -->
      <div class="flex flex-col">
        <div class="flex flex-col w-full h-full rounded-xl border border-accent bg-thirdly shadow px-3 py-4 md:px-4 md:py-5">
          <div class="flex-grow flex flex-col justify-between">
            <div>
              <div class="rounded-full bg-primary p-2.5 mx-auto mb-2 w-fit">
                <Icon name="tabler:shopping-bag" class="w-5 h-5 text-accent" />
              </div>
              <h3 class="text-sm md:text-base font-semibold uppercase text-primary text-center leading-tight">יום הקניות הגדול</h3>
              <p class="font-light text-muted text-center mt-1 mb-2 text-xs leading-snug">יום שכולו FUN</p>
              <p class="text-center text-primary mb-1">
                <span class="text-2xl md:text-3xl font-bold">1,800</span>
                <span class="text-xs md:text-sm font-medium align-bottom">₪</span>
              </p>
              <p class="text-[11px] text-muted text-center mb-3">&nbsp;</p>
            </div>
          </div>
          <div class="flex justify-center">
            <Button text="לתיאום פגישה" href="https://wa.me/972543452440" class="w-full text-sm" />
          </div>
        </div>
      </div>

      <!-- 3. Small return visit -->
      <div class="flex flex-col">
        <div class="flex flex-col w-full h-full rounded-xl border border-accent bg-thirdly shadow px-3 py-4 md:px-4 md:py-5">
          <div class="flex-grow flex flex-col justify-between">
            <div>
              <div class="rounded-full bg-primary p-2.5 mx-auto mb-2 w-fit">
                <Icon name="tabler:refresh" class="w-5 h-5 text-accent" />
              </div>
              <h3 class="text-sm md:text-base font-semibold uppercase text-primary text-center leading-tight">באה לביקור קטן</h3>
              <p class="font-light text-muted text-center mt-1 mb-2 text-xs leading-snug">ביקור רענון</p>
              <p class="text-center text-primary mb-1">
                <span class="text-2xl md:text-3xl font-bold">650</span>
                <span class="text-xs md:text-sm font-medium align-bottom">₪</span>
              </p>
              <p class="text-[11px] text-muted text-center mb-3">המחיר עשוי להשתנות בהתאם למרחק הנסיעה</p>
            </div>
          </div>
          <div class="flex justify-center">
            <Button text="לתיאום פגישה" href="https://wa.me/972543452440" class="w-full text-sm" />
          </div>
        </div>
      </div>

      <!-- 4. Home visit standalone -->
      <div class="flex flex-col">
        <div class="flex flex-col w-full h-full rounded-xl border border-accent bg-thirdly shadow px-3 py-4 md:px-4 md:py-5">
          <div class="flex-grow flex flex-col justify-between">
            <div>
              <div class="rounded-full bg-primary p-2.5 mx-auto mb-2 w-fit">
                <Icon name="tabler:home" class="w-5 h-5 text-accent" />
              </div>
              <h3 class="text-sm md:text-base font-semibold uppercase text-primary text-center leading-tight">באה לביקור בלבד</h3>
              <p class="font-light text-muted text-center mt-1 mb-2 text-xs leading-snug">הפכו את הארון לאפקטיבי</p>
              <p class="text-center text-primary mb-1">
                <span class="text-2xl md:text-3xl font-bold">1,500</span>
                <span class="text-xs md:text-sm font-medium align-bottom">₪</span>
              </p>
              <p class="text-[11px] text-muted text-center mb-3">המחיר עשוי להשתנות בהתאם למרחק הנסיעה</p>
            </div>
          </div>
          <div class="flex justify-center">
            <Button text="לתיאום פגישה" href="https://wa.me/972543452440" class="w-full text-sm" />
          </div>
        </div>
      </div>

      <!-- 5. Focused event -->
      <div class="flex flex-col">
        <div class="flex flex-col w-full h-full rounded-xl border border-accent bg-thirdly shadow px-3 py-4 md:px-4 md:py-5">
          <div class="flex-grow flex flex-col justify-between">
            <div>
              <div class="rounded-full bg-primary p-2.5 mx-auto mb-2 w-fit">
                <Icon name="tabler:calendar-star" class="w-5 h-5 text-accent" />
              </div>
              <h3 class="text-sm md:text-base font-semibold uppercase text-primary text-center leading-tight">ארוע ממוקד</h3>
              <p class="font-light text-muted text-center mt-1 mb-2 text-xs leading-snug">תמחור שעתי</p>
              <p class="text-center text-primary mb-1">
                <span class="text-2xl md:text-3xl font-bold">320</span>
                <span class="text-xs md:text-sm font-medium align-bottom">₪</span>
              </p>
              <p class="text-[11px] text-muted text-center mb-3">המחיר עשוי להשתנות בהתאם למרחק הנסיעה</p>
            </div>
          </div>
          <div class="flex justify-center">
            <Button text="לתיאום פגישה" href="https://wa.me/972543452440" class="w-full text-sm" />
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER NOTES -->
    <div class="max-w-3xl mx-auto mb-10">
      <div class="rounded-xl border border-accent bg-thirdly shadow px-5 py-5 md:px-6 md:py-6 text-center space-y-2 text-sm text-muted">
        <p>הקניות כמובן מתבצעות מכיסך ולפי תקציב שנקבע יחד מראש על מנת להיות ממוקדות ובכדי לא להתפזר.</p>
        <p>התשלום עבורי יכול להתבצע באמצעות: העברה בנקאית / ביט / מזומן.</p>
        <p>לכל שאלה נוספת ניתן לפנות בוואטסאפ.</p>
      </div>
    </div>

    <div class="text-center mb-6">
      <Button text="לשאלות ותיאום — בואו נדבר" href="https://wa.me/972543452440" icon="tabler:brand-whatsapp" />
    </div>
  </section>
</Layout>