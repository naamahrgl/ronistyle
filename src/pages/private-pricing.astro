---
// src/pages/private-pricing.astro
// NOT linked in navigation - share this URL directly with potential clients
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import logoImg from '~/assets/images/bowtie.png';
import bowtieImg from '~/assets/images/bowtie2.png';

const metadata = {
  title: 'התהליך והמחירון | Roni Style',
};


interface PackageSection {
  heading?: string;
  meta?: string;
  paragraphs: string[];
}

interface Package {
  id: string;
  highlight?: boolean;
  icon: string;
  title: string;
  subtitle: string;
  duration?: string;
  price: string;
  priceadditional?: string;
  priceNote: string | null;
  sections: PackageSection[];
}
// Each package carries its own service description(s),
// so price + explanation always live in the same card.
const packages: Package[] = [
  {
    id: 'combo',
    highlight: true,
    icon: 'tabler:sparkles',
    title: 'חבילת הפפיון',
    subtitle: 'באה לביקור + יום הקניות הגדול',
    price: '2,500',
    priceNote: 'המחיר עשוי להשתנות בהתאם למרחק הנסיעה',
    sections: [
      {
        heading: 'באה לביקור',
        meta: 'אצלך בבית · עד 4 שעות',
        paragraphs: [
          'המטרה שלנו היא ליצור ארון בגדים חכם, מסודר ואפקטיבי, שיהפוך את ההתארגנות היומיומית לפשוטה ומהירה, עם פריטים שקל לשלב ולהתאים לכל מטרה -עבודה, פגישות, נסיעות או בילויים.',
          'נתחיל במיון יסודי של המלתחה הקיימת. נבחן יחד אילו גזרות, צבעים ופריטים מחמיאים ומתאימים לסגנון האישי, וניפרד ממה שכבר לא משרת אותנו.',
          'משם ניצור שילובים חדשים ומעניינים מתוך הבגדים שכבר נמצאים בארון, כדי להפיק את המקסימום מכל פריט ולגלות אפשרויות שאולי לא חשבנו עליהן קודם.',
          'במהלך המפגש אצלם את הלוקים שנרכיב, כך שתמיד יהיה אפשר לחזור אליהם ולקבל השראה.',
          'לסיום, נכין רשימה ממוקדת של פריטים שחסרים במלתחה ויוכלו להשלים ולהעשיר אותה בהמשך.'
        ],
      },
      {
        heading: 'יום הקניות הגדול',
        meta: 'מתקיים בת"א · עד 6 שעות',
        paragraphs: [
          'יום שכולו FUN, אופנה וסטייל!',
          'אני מגיעה מראש למקום שנבחר יחד, מאתרת את הפריטים המתאימים ומכינה מלתחה ראשונית לקראת המפגש שלנו.',
          'כשניפגש, נתחיל במדידות, נבחן מה מחמיא, מה מרגיש נכון ומה פחות, ומשם נמשיך לדייק ולבנות מלתחה שמתאימה לסגנון האישי, למבנה הגוף ולאורח החיים.',
          'לרוב אני עורכת את יום הקניות בקניון TLV, שמציע מגוון רחב של מותגים וחנויות, מפריטי בסיס ועד פריטי יוקרה. כמובן שאפשר לבחור גם חנויות ייחודיות אחרות, בהתאם לסגנון ולתקציב שנגדיר מראש.',
          'לאורך היום אשתף בטיפים לבחירת פריטים מדויקים, לשילובים מעניינים וליצירת הופעות מגוונות שאולי לא חשבנו עליהן קודם.',
          'את הלוקים שנרכיב אצלם לאורך היום, כדי שתמיד יהיה אפשר לחזור אליהם ולשחזר אותם בקלות בכל שלב .',
          'המטרה היא לצאת עם מלתחה חכמה, מדויקת ומלאה בסטייל, ובעיקר עם כלים וביטחון להמשיך לבחור נכון גם בקניות הבאות.',
          'והכי חשוב:',
          'נהפוך את כל התהליך הזה לחוויה קלילה, משחררת ובעיקר ממש כיפית!'
        ],
      },
    ],
  },
  {
    id: 'home-visit',
    icon: 'tabler:home',
    title: 'באה לביקור בלבד',
    subtitle: 'הפכו את הארון לאפקטיבי',
    duration: 'אצלך בבית · עד 4 שעות · לקוחות חדשים וחוזרים',
    price: '1,500',
    priceNote: 'המחיר עשוי להשתנות בהתאם למרחק הנסיעה',
    sections: [
      {
        paragraphs: [
          'המטרה שלנו היא ליצור ארון בגדים חכם ואפקטיבי, שיהפוך את ההתארגנות היומיומית לפשוטה ומהירה. ארון שבו הכול נגיש, מסודר וקל למצוא את הפריטים המתאימים לכל מטרה - עבודה, פגישות, נסיעות או בילויים.',
          'נתחיל במיון יסודי של המלתחה הקיימת: נבדוק יחד אילו גזרות, צבעים ופריטים מחמיאים ומתאימים לסגנון האישי, וניפרד ממה שכבר לא נוח או לא משרת אותנו.',
          'לאחר מכן ניצור מגוון לוקים ושילובים חדשים ומעניינים מתוך מה שכבר יש בארון, כדי להפיק את המקסימום מכל פריט ולגלות אפשרויות שאולי לא חשבנו עליהן קודם.',
          'במהלך המפגש אצלם את הלוקים שנרכיב יחד, כדי שתמיד יהיה אפשר לחזור אליהם ולשחזר אותם בקלות.',
          'לסיום, נכין רשימה ממוקדת של פריטים שחסרים במלתחה ויוכלו להעשיר אותה בהמשך. ואם מתחשק להמשיך לשלב הבא, נקבע גם את המפגש המשלים : ״יום הקניות הגדול״ (ממליצה בחום!)',

        ],
      },
    ],
  },
  {
    id: 'shopping-day',
    icon: 'tabler:shopping-bag',
    title: 'יום הקניות הגדול',
    subtitle: 'יום שכולו FUN',
    duration: 'מתקיים בת"א · עד 6 שעות · לקוחות חוזרים בלבד',
    price: '1,800',
    priceNote: null,
    sections: [
      {
        paragraphs: [
          'אני מגיעה מראש למקום שנבחר יחד, מאתרת את הפריטים המתאימים ומכינה מלתחה ראשונית לקראת המפגש שלנו.',
'כשניפגש, נתחיל במדידות, נבחן מה מחמיא, מה מרגיש נכון ומה פחות, ומשם נמשיך לדייק ולבנות מלתחה שמתאימה לסגנון האישי, למבנה הגוף ולאורח החיים.',
'לרוב אני עורכת את יום הקניות בקניון TLV, שמציע מגוון רחב של מותגים וחנויות, מפריטי בסיס ועד פריטי יוקרה. כמובן שאפשר לבחור גם חנויות ייחודיות אחרות, בהתאם לסגנון ולתקציב שנגדיר מראש.',
'עם הרשימה שהכנו, נבחר פריטים מחמיאים, צבעים מדויקים ושילובים מעניינים, שיהפכו את המלתחה למגוונת ושימושית יותר.',
'לאורך היום אשתף בטיפים לבחירת פריטים נכונים וליצירת הופעות חדשות, כדי שגם בהמשך יהיה קל יותר לעשות קניות בצורה חכמה ומדויקת.',
'את הלוקים שנרכיב אצלם לאורך היום, כדי שתמיד יהיה אפשר לחזור אליהם ולשחזר אותם בקלות.',
'והכי חשוב: נהפוך את כל התהליך הזה לחוויה קלילה, משחררת ובעיקר ממש כיפית!'
          
        ],
      },
    ],
  },
  {
    id: 'refresh-visit',
    icon: 'tabler:refresh',
    title: 'באה לביקור קטן',
    subtitle: 'ביקור רענון',
    duration: 'עד שעתיים · לקוחות חוזרים בלבד',
    price: '650',
    priceNote: 'המחיר עשוי להשתנות בהתאם למרחק הנסיעה',
    sections: [
      {
        paragraphs: [
          'מיועד ללקוחות שרוצים לחדש ולרענן את המלתחה, עם ביקור ביתי קצר וממוקד כהכנה ליום קניות משותף.'
        ],
      },
    ],
  },
  {
    id: 'event',
    icon: 'tabler:calendar-star',
    title: 'ארוע ממוקד',
    subtitle: 'אם תרצו לנצוץ',
    duration: 'מתקיים בת"א · לקוחות חדשים וחוזרים',
    price: '350',
    priceadditional: 'לשעה (מינימום שעתיים)',
    priceNote: 'התמחור הוא שעתי , ועשוי להשתנות בהתאם למרחק הנסיעה.',
    sections: [
      {
        paragraphs: [
          'ליווי אישי למציאת הלוק המושלם לאירוע .',
          'נתחיל בפגישת היכרות קצרה בבית קפה, שבה נכיר, נבין את הצרכים ונדייק את הסגנון וההופעה המתאימה ביותר לאירוע.',
'משם נמשיך יחד ליום קניות ממוקד, מדויק ויעיל, עד שנמצא את הלוק שיגרום לך להרגיש הכי טוב שאפשר'
        
        ],
      },
    ],
  },
];

const combo = packages.find((p) => p.highlight);
const rest = packages.filter((p) => !p.highlight);
---

<Layout metadata={metadata}>
  <section class="bg-page py-10 md:py-16 px-4">

    <!-- INTRO -->
    <div class="max-w-3xl mx-auto text-center mb-10 md:mb-14">
      <div class="mb-5 flex justify-center">
        <Image src={logoImg} alt="Roni Style" width={180} class="h-auto" />
      </div>
      <h1 class="text-2xl md:text-3xl font-bold text-primary mb-4">
        אם הגעתם לכאן כנראה שהגיע הזמן לדייק את הסטייל שלכם
      </h1>
      <p class="text-muted text-base md:text-lg font-bold">
        השירותים שלי מיועדים לנשים ולגברים בכל גיל ובכל שלב בחיים
      </p>
    </div>

    <!-- PACKAGES -->


    <div class="max-w-5xl mx-auto flex flex-col gap-4 md:gap-5 mb-6 md:mb-8">

      <!-- Highlighted combo package -->
      {combo && (
        <div class="relative rounded-xl border-2 border-primary bg-thirdly shadow-lg overflow-visible">
          <div class="absolute -top-3 -right-3 z-[1] w-16 h-16 overflow-visible">
            <img src={bowtieImg.src} alt="Bowtie" class="w-full h-full object-contain rotate-45" />
          </div>

          <div class="flex flex-col items-center text-center px-5 pt-6 pb-4 md:px-8 md:pt-8">
            <div class="rounded-full bg-primary p-2.5 mb-2">
              <Icon name={combo.icon} class="w-5 h-5 text-accent" />
            </div>
            <h3 class="text-base md:text-lg font-semibold uppercase text-primary leading-tight">{combo.title}</h3>
            <p class="font-light text-muted mt-1 text-xs md:text-sm leading-snug">{combo.subtitle}</p>
      
          </div>

          <div class="px-5 pb-2 md:px-8">
            <div class="border-t border-accent/40 pt-4 space-y-5 text-start">
              {combo.sections.map((section) => (
                <div>
                  {section.heading && (
                    <div class="mb-2">
                      <h4 class="text-sm md:text-base font-semibold text-primary">{section.heading}</h4>
                      {section.meta && <p class="text-[11px] text-muted">{section.meta}</p>}
                    </div>
                  )}
                  <div class="text-sm text-primary font-medium space-y-3">
                    {section.paragraphs.map((p) => (
                      <p style="line-height: 1.25rem;">{p}</p>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
                    <div class="flex flex-col items-center text-center px-5 pt-6 pb-4 md:px-8 md:pt-8">

                <p class="text-primary mt-3">
              <span class="text-2xl md:text-3xl font-bold">{combo.price}</span>
              <span class="text-xs md:text-sm font-medium align-bottom">₪</span>
            </p>
            {combo.priceNote && <p class="text-[11px] text-muted mt-1">{combo.priceNote}</p>}
            </div>

          <div class="px-5 pb-5 pt-4 md:px-8 flex justify-center">
            <Button text="אני רוצה לתאם" href="https://wa.me/972543452440" class="w-full sm:w-auto sm:min-w-[220px]" />
          </div>
        </div>
      )}

      <!-- Remaining packages -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5">
        {rest.map((pkg) => (
          <div class="rounded-xl border border-accent bg-thirdly shadow overflow-hidden flex flex-col">
            <div class="flex flex-col items-center text-center px-4 pt-5 pb-3 md:px-5">
              <div class="rounded-full bg-primary p-2.5 mb-2">
                <Icon name={pkg.icon} class="w-5 h-5 text-accent" />
              </div>
              <h3 class="text-lg md:text-lg font-semibold uppercase text-primary leading-tight">{pkg.title}</h3>
              <p class="font-light text-muted mt-1 text-sm leading-snug">{pkg.subtitle}</p>
              <p class="text-xs text-muted mt-1">{pkg.duration}</p>
   
            </div>

            <div class="px-4 pb-2 md:px-5">
              <div class="border-t border-accent/40 pt-4 text-sm text-primary font-medium space-y-3 text-start">
                {pkg.sections[0].paragraphs.map((p) => (
                  <p style="line-height: 1.25rem;">{p}</p>
                ))}
              </div>
            </div>
                   <!-- Price block: mt-auto pushes it (and the button below) to the bottom of the card -->
            <div class="mt-auto flex flex-col items-center text-center px-5 pt-6 pb-0 md:px-8 md:pt-8">
              <p class="text-primary mt-2">
                <span class="text-2xl md:text-3xl font-bold">{pkg.price}</span>
                <span class="text-xs md:text-sm font-medium align-bottom">₪</span>
              </p>
              {pkg.priceadditional && (
                <p class="text-sm md:text-base font-medium text-primary mt-0.5">{pkg.priceadditional}</p>
              )}
              {pkg.priceNote && <p class="text-[11px] text-muted mt-1">{pkg.priceNote}</p>}
            </div>

            <div class="px-4 pb-5 pt-4 md:px-5 flex justify-center">
              <Button text="אני רוצה לתאם" href="https://wa.me/972543452440" class="w-full text-sm" />
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- GIFT COUPON NOTE -->
    <div class="max-w-5xl mx-auto mb-10 md:mb-14">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3 sm:gap-4 rounded-xl border border-2 border-primary bg-thirdly/60 px-5 py-5 md:px-6 text-center sm:text-start">
        <div class="rounded-full bg-primary p-2.5 shrink-0">
          <Icon name="tabler:gift" class="w-5 h-5 text-accent" />
        </div>
        <div>
          <h3 class="text-sm md:text-base font-semibold text-primary mb-1">מחפשים מתנה מיוחדת?</h3>
          <p class="text-sm text-muted">
            ניתן לרכוש שובר מתנה לכל אחת מחבילות הסטיילינג - מתנה מושלמת לימי הולדת ולאירועים מיוחדים, ודרך אישית ומרגשת לפנק מישהו שאוהבים בחוויה שכולה מוקדשת לו
          </p>
        </div>
      </div>
    </div>

    <!-- FOOTER NOTES -->
    <div class="max-w-3xl mx-auto mb-10">
      <div class="rounded-xl border border-accent bg-thirdly shadow px-5 py-5 md:px-6 md:py-6 text-center space-y-2 text-sm text-muted">
        <p>הקניות מתבצעות מכיסך ולפי תקציב שנקבע יחד מראש על מנת להיות ממוקדות ובכדי לא להתפזר.</p>
        <p>התשלום עבורי יכול להתבצע באמצעות: העברה בנקאית / ביט / מזומן.</p>
        <p>לכל שאלה נוספת ניתן לפנות בוואטסאפ.</p>
      </div>
    </div>

    <div class="text-center mb-6">
      <Button text="לשאלות ותיאום - בואו נדבר" href="https://wa.me/972543452440" icon="tabler:brand-whatsapp" />
    </div>
  </section>
</Layout>