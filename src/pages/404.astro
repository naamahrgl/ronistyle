---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import logoImg from '~/assets/images/bowtie.png';
import Image from '~/components/common/Image.astro';

const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
            <div class="mb-5 flex justify-center">
        <Image src={logoImg} alt="Roni Style" width={180} class="h-auto " />
      </div>
        <p class="text-3xl font-semibold md:text-3xl">העמוד לא נמצא!</p>
    
        <p class="mt-4 mb-8 text-lg text-muted ">
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn ml-4">חזרה לעמוד הראשי</a>
      </div>
    </div>
  </section>
</Layout>
