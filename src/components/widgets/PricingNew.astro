---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Pricing as Props } from '~/types';

import bowtieImg from '~/assets/images/bowtie2.png';

const { title = '', subtitle = '', tagline = '', prices = [], id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-start justify-items-center">
    {prices && prices.map((price) => (
      <div class="w-full flex flex-col">

        <div class="flex flex-col w-full rounded-lg backdrop-blur border border-accent bg-thirdly text-primary shadow px-4 py-6 relative transition-all duration-300">
          <div class="flex flex-col">

            <div class="relative">
              {price.hasRibbon && (
                <div class="absolute -top-10 -right-8 z-[1] w-20 h-20 overflow-visible">
                  <img
                    src={bowtieImg.src}
                    alt="Bowtie"
                    class="w-full h-full object-contain rotate-45"
                  />
                </div>
              )}
              <h3 class="text-center text-xl font-semibold uppercase mb-1">{price.title}</h3>

              <div class="w-24 h-[2px] mx-auto my-3 bg-gradient-to-r from-[#E4D5C7] via-[#D8C5B4] to-[#E4D5C7]"></div>

              {price.feat && <p class="font-light text-center mb-1">{price.feat}</p>}
            </div>

            <input type="checkbox" id={`toggle-${price.title}`} class="peer hidden" />

            <div class="max-h-0 overflow-hidden peer-checked:max-h-[1000px] transition-all duration-500 ease-in-out">
              {price.subtitle && <p class="font-light text-muted mb-6">{price.subtitle}</p>}
              {price.items && (
                <ul class="space-y-3 text-right mb-2">
                  {price.items.map(({ description, icon, more_text }) => (
                    <li>
                      <div class="flex items-start space-x-3">
                        <div class="rounded-full bg-primary mt-1 shrink-0"><Icon name={icon || 'tabler:check'} class="w-4 h-4 p-0.5 text-muted" /></div>
                        <span class="font-medium text-primary items-center">{description}</span>
                      </div>
                      {more_text && <p class="text-sm text-muted mt-1 mr-7">{more_text}</p>}
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <label for={`toggle-${price.title}`} class="peer-checked:hidden flex items-center justify-center mt-4 cursor-pointer text-muted hover:text-primary transition">
              קראו עוד
              <Icon name="tabler:chevron-down" class="w-4 h-4 ml-1" />
            </label>

            <label for={`toggle-${price.title}`} class="hidden peer-checked:flex items-center justify-center mt-4 cursor-pointer text-muted hover:text-primary transition">
              קראו פחות
              <Icon name="tabler:chevron-up" class="w-4 h-4 ml-1" />
            </label>
          </div>

          {price.callToAction && (
            <div class="mt-4 flex justify-center">
              <Button {...price.callToAction} class="w-full sm:w-auto bg-[#E4D5C7] hover:bg-[#D8C5B4]" />
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</WidgetWrapper>