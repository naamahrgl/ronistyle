---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  actions = await Astro.slots.render('actions'),
  image,
  logo,
  id,
} = Astro.props;
---

<section
  class="relative h-[70vh] sm:h-[75vh] md:h-[85vh] overflow-hidden bg-page"
  {...id ? { id } : {}}
>

  {/* Image layer — pinned to the left edge, free to bleed toward center.
      This no longer participates in the content's flex layout at all,
      so it can never push or overlap-on-top-of the logo/text again. */}
  <div class="absolute right-0 top-0 h-full w-[58%] sm:w-[50%] md:w-[45%] z-0 overflow-visible">
    {image && (
      <Image
        layout="cover"
        style="width: 100%; height: 100%; object-position: top center;"
        widths={[400, 768, 1024, 2040]}
        sizes="60vw"
        loading="eager"
        {...image}
      />
    )}
  </div>

  {/* Content layer — sits above the image (z-10), anchored to the right
      regardless of how far the image bleeds underneath it. */}
  <div class="relative z-10 h-full flex items-center justify-center">
    <div class="w-full max-w-sm md:max-w-md lg:max-w-lg px-4 sm:px-6 md:pr-10 lg:pr-16
                flex flex-col items-end md:items-center text-end md:text-center
                gap-4 md:gap-6 text-[#451113]">

      {logo && (
        <div class="max-w-[180px] md:max-w-[240px] lg:max-w-[280px]">
          <Image class="h-auto drop-shadow-2xl" {...logo} />
        </div>
      )}

      {tagline && (
        <p class="font-bold tracking-widest uppercase text-sm md:text-base">{tagline}</p>
      )}

      {subtitle && (
        <div class="text-lg sm:text-xl md:text-2xl font-bold" set:html={subtitle} />
      )}

      {actions && (
        <div class="flex flex-col sm:flex-row gap-4 mt-2">
          {Array.isArray(actions) ? (
            actions.map((action) => <Button {...(action || {})} />)
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )}
    </div>
  </div>

</section>