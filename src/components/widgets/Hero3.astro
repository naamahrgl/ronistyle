---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  actions = await Astro.slots.render('actions'),
  image,     // extended-desktop crop (~1:1) — default across mobile/tablet/most laptops
  imageWide, // 2:1 crop — only for genuinely large screens, falls back to `image`
  logo,
  id,
} = Astro.props;

const wideImage = imageWide ?? image;
---

<section
  class="relative h-[70vh] sm:h-[75vh] md:h-[85vh] overflow-hidden bg-page"
  {...id ? { id } : {}}
>

  {/* Default background — extended-desktop crop, used at every size
      up until the "genuinely wide screen" tier below */}
  {image && (
    <div class="absolute inset-0 w-full h-full z-0 2xl:hidden">
      <Image
        layout="cover"
        style="width: 100%; height: 100%; object-position: top center;"
        widths={[400, 768, 1024, 1600]}
        sizes="100vw"
        loading="eager"
        {...image}
      />
    </div>
  )}

  {/* Wide-screen background — only at 2xl and up (1536px+) */}
  {wideImage && (
    <div class="hidden 2xl:block absolute inset-0 w-full h-full z-0">
      <Image
        layout="cover"
        style="width: 100%; height: 100%; object-position: top center;"
        widths={[1536, 1920, 2800]}
        sizes="100vw"
        loading="eager"
        {...wideImage}
      />
    </div>
  )}

  <div class="relative z-10 h-full flex items-center justify-center">
    <div class="w-full max-w-sm md:max-w-md lg:max-w-lg px-4 sm:px-6 md:pr-10 lg:pr-16
                flex flex-col items-end md:items-center text-end md:text-center
                gap-4 md:gap-6 text-[#451113]">

      {logo && (
        <div class="max-w-[180px] md:max-w-[240px] lg:max-w-[280px]">
          <Image class="h-auto drop-shadow-2xl" {...logo} />
        </div>
      )}

      {tagline && (
        <p class="font-bold tracking-widest uppercase text-sm md:text-base">{tagline}</p>
      )}

      {subtitle && (
        <div class="text-lg sm:text-xl md:text-2xl font-bold text-accent" set:html={subtitle} />
      )}

      {actions && (
        <div class="flex flex-col sm:flex-row gap-4 mt-2">
          {Array.isArray(actions) ? (
            actions.map((action) => <Button {...(action || {})} />)
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )}
    </div>
  </div>

</section>