---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  actions = await Astro.slots.render('actions'),
  image,
  imageWide,
  logo,
  id,
} = Astro.props;

const wideImage = imageWide ?? image;
---

<section
  class="hero-section relative overflow-hidden bg-accent"
  {...id ? { id } : {}}
>
  {image && (
    <div class="absolute inset-0 w-full h-full z-0">
      <Image
        layout="cover"
        style="width: 100%; height: 100%; object-position: top center;"
        widths={[400, 768, 1024, 1600]}
        sizes="100vw"
        loading="eager"
        {...image}
      />
    </div>
  )}

  <div class="relative z-10 h-full flex items-end justify-end">
    <div class="w-full max-w-sm md:max-w-md lg:max-w-lg px-4 py-4 sm:px-6 md:pr-10 lg:pr-16
                flex flex-col items-end text-end
                gap-4 md:gap-6 text-primary">

      {logo && (
        <div class="max-w-[120px] md:max-w-[180px] lg:max-w-[240px]">
          <Image class="h-auto drop-shadow-2xl" {...logo} />
        </div>
      )}

      {tagline && (
        <p class="font-bold tracking-widest uppercase text-sm md:text-base">{tagline}</p>
      )}

      {subtitle && (
        <div class="text-lg sm:text-xl md:text-2xl font-bold text-accent" set:html={subtitle} />
      )}

      {actions && (
        <div class="flex flex-col sm:flex-row gap-4 mt-2">
          {Array.isArray(actions) ? (
            actions.map((action) => <Button {...(action || {})} />)
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-section {
    height: 70vh;
    height: 70dvh;
    min-height: 420px;
    max-height: 900px;
  }

  @media (max-width: 639px) {
    .hero-section {
      height: 56vh;
      height: 56dvh;
      min-height: 380px;
      max-height: 640px;
    }
  }
</style>