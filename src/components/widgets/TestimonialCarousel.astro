---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

interface Testimonial { testimonial: string; name: string; job: string; }
interface Props { title?: string; subtitle?: string; tagline?: string; testimonials?: Testimonial[]; id?: string; isDark?: boolean; }

const { title = '', subtitle = '', tagline = '', testimonials = [], id, isDark = false } = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass="max-w-6xl mx-auto relative group">
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div class="relative px-10" data-testimonial-carousel>
  <div
  class="testimonial-track flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
  dir="rtl"
>
  {testimonials.map(({ testimonial, name, job }, i) => (
    <div class="testimonial-slide shrink-0 basis-full snap-start" data-index={i}>
      <div class="max-w-xl mx-auto flex flex-col p-6 rounded-lg shadow-xl h-full border border-accent bg-primary text-accent">
        <blockquote class="flex-auto">
          <p class="text-lg italic text-accent">"{testimonial}"</p>
        </blockquote>
        <div class="mt-6 border-t border-accent pt-4">
          <p class="font-semibold text-thirdly">{name}</p>
          <p class="text-sm text-thirdly">{job}</p>
        </div>
      </div>
    </div>
  ))}
</div>

    <!-- RTL: "prev" (earlier content) sits on the right, "next" on the left — mirrored on purpose -->
    <button type="button" class="testimonial-prev absolute top-1/2 -translate-y-1/2 -right-2 md:-right-4 text-muted hover:text-primary opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300 disabled:opacity-20" aria-label="הקודם">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </button>
    <button type="button" class="testimonial-next absolute top-1/2 -translate-y-1/2 -left-2 md:-left-4 text-muted hover:text-primary opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300 disabled:opacity-20" aria-label="הבא">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
    </button>

    <div class="mt-4 h-1 w-full rounded-full bg-primary/15 overflow-hidden">
      <div class="testimonial-progress h-full rounded-full bg-primary transition-[width] duration-300" style="width:0%"></div>
    </div>
  </div>
</WidgetWrapper>

<script>
  function initTestimonialCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('.testimonial-track');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.testimonial-slide'));
    const prevBtn = root.querySelector<HTMLButtonElement>('.testimonial-prev');
    const nextBtn = root.querySelector<HTMLButtonElement>('.testimonial-next');
    const progress = root.querySelector<HTMLElement>('.testimonial-progress');
    if (!track || !slides.length) return;

    let current = 0;
    let isProgrammaticScroll = false;
    let scrollEndTimer: number;

    const update = () => {
      if (progress) progress.style.width = `${(current / (slides.length - 1)) * 100}%`;
    };

  const goTo = (index: number) => {
  current = (index + slides.length) % slides.length;
  isProgrammaticScroll = true;

  const trackRect = track.getBoundingClientRect();
  const slideRect = slides[current].getBoundingClientRect();
  const delta = slideRect.left - trackRect.left;
  track.scrollBy({ left: delta, behavior: 'smooth' });

  update();
  window.clearTimeout(scrollEndTimer);
  scrollEndTimer = window.setTimeout(() => { isProgrammaticScroll = false; }, 500);
};

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));

    // Only resync `current` from scroll position after a manual drag/swipe —
    // never during our own programmatic steps.
    let dragDebounce: number;
    track.addEventListener('scroll', () => {
      if (isProgrammaticScroll) return;
      window.clearTimeout(dragDebounce);
      dragDebounce = window.setTimeout(() => {
        let closest = 0;
        let closestDist = Infinity;
        slides.forEach((slide, i) => {
          const dist = Math.abs(slide.offsetLeft - track.scrollLeft);
          if (dist < closestDist) { closestDist = dist; closest = i; }
        });
        current = closest;
        update();
      }, 120);
    });

    let autoplay = window.setInterval(() => goTo(current + 1), 4000);
    root.addEventListener('mouseenter', () => window.clearInterval(autoplay));
    root.addEventListener('mouseleave', () => {
      autoplay = window.setInterval(() => goTo(current + 1), 4000);
    });

    update();
  }

  document.querySelectorAll<HTMLElement>('[data-testimonial-carousel]').forEach(initTestimonialCarousel);
</script>