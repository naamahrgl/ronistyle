---
import { Icon } from 'astro-icon/components';

interface Link { text?: string; href?: string; ariaLabel?: string; icon?: string; }
interface ContactInfo { name: string; title: string; email: string; }
interface Props { contact: ContactInfo; quickLinks: Link[]; secondaryLinks: Link[]; socialLinks: Link[]; }

const { contact, quickLinks = [], secondaryLinks = [], socialLinks = [] } = Astro.props;
---

<footer class="border-t border-muted py-16 bg-thirdly ">
  <div class="max-w-4xl mx-auto px-6 text-center">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
      
      <div class="flex flex-col items-center gap-2">
        <h2 class="text-2xl font-bold tracking-tight">{contact.name}</h2>
        <p class="text-primary ">{contact.title}</p>
        <a href={`mailto:${contact.email}`} class="text-muted hover:underline font-medium">{contact.email}</a>
        <ul class="flex gap-6">
        {socialLinks.map((social: Link) => (
          <li>
            <a href={social.href} aria-label={social.ariaLabel} class="text-muted hover:text-accent  transition">
              {social.icon && <Icon name={social.icon} class="w-6 h-6" />}
            </a>
          </li>
        ))}
      </ul>
      
   
      </div>

      <div class="flex flex-col items-center  gap-2">
        <h3 class="font-bold text-lg mb-1">ניווט מהיר</h3>
        <ul class="flex flex-col gap-1">
          {quickLinks.map((link: Link) => (
            <li>
              <a href={link.href} class="text-muted hover:text-accent  transition">
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center gap-6 pt-8 border-t border-muted ">

      
      <div class="text-sm text-muted">
        {secondaryLinks.map((link: Link, index: number) => (
          <span class="px-2">
            <a href={link.href} class="hover:underline">{link.text}</a>
            {index < secondaryLinks.length - 1 ? '•' : ''}
          </span>
        ))}
      </div>
    </div>

  </div>
</footer>