---

<style is:inline>
  :root {
    --aw-font-sans: 'MPLUS1p';
    --aw-font-serif: 'MPLUS1p';
    --aw-font-heading: 'MPLUS1p';

    --aw-color-primary: #451113;
    --aw-color-secondary: #8a595b;
    --aw-color-accent: #fffdf9;
    --aw-color-thirdly: #E4D5C7;


    --aw-color-text-heading:#451113;
    --aw-color-text-default:#451113;
    --aw-color-text-muted: #8a595b;
    --aw-color-bg-page: #fffdf9 ;

    --aw-color-bg-page-dark: #f9e4e4 ;

    ::selection {
      background-color: ring-blue-500;
    }
  }

  .dark {
    --aw-font-sans: 'MPLUS1p';
    --aw-font-serif: 'MPLUS1p';
    --aw-font-heading: 'MPLUS1p';

   --aw-color-primary: #451113;
    --aw-color-secondary: #8a595b;
    --aw-color-accent: #fffdf9;

  --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: #fffdf9 ;

        --aw-color-bg-page-dark: #f9e4e4 ;


    ::selection {
      background-color: ring-blue-500;
    }
  }
</style>
