---

<style is:inline>
  :root {
    --aw-font-sans: 'MPLUS1p';
    --aw-font-serif: 'MPLUS1p';
    --aw-font-heading: 'MPLUS1p';

    --aw-color-primary: #4C1416;
    --aw-color-secondary: #835455;
    --aw-color-accent: #FAF7F0;
    --aw-color-thirdly: #EAE4D9;


  --color-accent-hover: #D8C5B4;

    --aw-color-text-heading:#4C1416;
    --aw-color-text-default:#4C1416;
    --aw-color-text-muted: #835455;
    --aw-color-bg-page: #FAF7F0 ;

    --aw-color-bg-page-dark: #EFE9DE ;

    ::selection {
      background-color: ring-blue-500;
    }
  }

  .dark {
    --aw-font-sans: 'MPLUS1p';
    --aw-font-serif: 'MPLUS1p';
    --aw-font-heading: 'MPLUS1p';

   --aw-color-primary: #4C1416;
    --aw-color-secondary: #835455;
    --aw-color-accent: #FAF7F0;

  --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: #FAF7F0 ;

        --aw-color-bg-page-dark: #EFE9DE ;


    ::selection {
      background-color: ring-blue-500;
    }
  }
</style>
