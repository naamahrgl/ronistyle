---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';

const { inputs, textarea, disclaimer, button = 'צרו קשר', description = '' } = Astro.props;
---

<div id="formWrapper" class="relative">

  <form id="contactForm">
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', options = [] }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                </label>
              )}

  {type === 'dropdown' ? (
    <select
      name={name}
      id={name}
      data-dropdown-name={name}
      class="py-3 px-4 block w-full text-md rounded-lg border border-primary p-2"
    >
      <option value="" disabled selected>{placeholder || 'בחר אפשרות'}</option>
      {options.map((opt) => (
        <option value={opt.value}>{opt.label}</option>
      ))}
    </select>
  ) : (
                <input
                  type={type}
                  name={name}
                  id={name}
                  autocomplete={autocomplete}
                  placeholder={placeholder}
                  class="py-3 px-4 block w-full text-md rounded-lg border border-primary"
                />
              )}
            </div>
          )
      )
  }

    {
      textarea && (
        <div>
          <label for="textarea" class="block text-sm font-medium">
            {textarea.label}
          </label>
          <textarea
            id="textarea"
            name={textarea.name ? textarea.name : 'message'}
            rows={textarea.rows ? textarea.rows : 4}
            placeholder={textarea.placeholder}
            class="py-3 px-4 block w-full text-md rounded-lg border border-primary   "
          />
        </div>
      )
    }

  {disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            required
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-primary"
          />
        </div>
        <div class="mr-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-muted">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )}

    {
      button && (
        <div class="mt-10 grid">
       <Button variant="primary" type="submit" id="submitBtn">
        {button}
      </Button>
        </div>
      )
    }

    {
      description && (
        <div class="mt-3 text-center">
          <p class="text-sm text-muted">{description}</p>
        </div>
      )
    }

    <div id="formError" class="mt-4 text-center hidden font-medium text-red-600"></div>
  </form>

  <!-- SUCCESS STATE — replaces the form entirely once submitted -->
  <div
    id="formSuccess"
    class="hidden flex-col items-center text-center gap-4 py-10 px-4"
  >
    <div class="success-icon-wrap rounded-full bg-primary p-4">
      <Icon name="tabler:check" class="w-8 h-8 text-accent" />
    </div>
    <h3 class="text-xl md:text-2xl font-bold text-primary">ההודעה נשלחה בהצלחה!</h3>
  <Logo />

    <p class="text-muted text-sm md:text-base max-w-sm">
      קיבלתי את ההודעה שלך, 
            <br />
     אחזור אליך ממש בקרוב ונתחיל לדייק את הסטייל שלך יחד.
    </p>
    <button type="button" id="sendAnotherBtn" class="mt-2 text-sm text-primary font-semibold text-accent underline underline-offset-4 cursor-pointer">
      שליחת הודעה נוספת
    </button>
  </div>

</div>

<style>
  #formSuccess.is-visible {
    display: flex;
    animation: success-in 400ms ease forwards;
  }

  .success-icon-wrap {
    animation: success-pop 500ms cubic-bezier(0.34, 1.56, 0.64, 1) 150ms both;
  }

  @keyframes success-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes success-pop {
    0% { transform: scale(0); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
</style>

<script is:inline>
  const form = document.getElementById('contactForm');
  const btn = document.getElementById('submitBtn');
  const errorDiv = document.getElementById('formError');
  const successPanel = document.getElementById('formSuccess');
  const wrapper = document.getElementById('formWrapper');
  const sendAnotherBtn = document.getElementById('sendAnotherBtn');

  const originalBtnText = btn.textContent;

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    btn.disabled = true;
    btn.textContent = 'שולח...';
    errorDiv.classList.add('hidden');

    const formData = new FormData(form);
    const params = new URLSearchParams();
    for (const pair of formData.entries()) {
      params.append(pair[0], pair[1]);
    }

    fetch('https://script.google.com/macros/s/AKfycbxDyCd_LuK4CIJwveNPuhvT6T_pkf-HfqbPAh-3UqtAfDLNS7WkAXz9zPB524AqQAc66g/exec', {
      method: 'POST',
      body: params,
      mode: 'no-cors',
    })
      .then(() => {
        form.reset();
        form.classList.add('hidden');
        successPanel.classList.add('is-visible');
        wrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
      })
      .catch(() => {
        errorDiv.textContent = 'משהו השתבש, נסו שוב או צרו קשר בוואטסאפ.';
        errorDiv.classList.remove('hidden');
      })
      .finally(() => {
        btn.disabled = false;
        btn.textContent = originalBtnText;
      });
  });

  sendAnotherBtn.addEventListener('click', () => {
    successPanel.classList.remove('is-visible');
    form.classList.remove('hidden');
  });
</script>